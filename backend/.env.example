# Set to 'production' on your server.
NODE_ENV=development
PORT=8080
PUBLIC_APP_ORIGIN=https://your-domain.com

# Required for production AI proxy
GROQ_API_KEY=gsk_xxx
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Storage: use Supabase in production. Use memory only for local single-process development.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but strongly recommended for WebRTC reliability.
# Comma-separated TURN/STUN URLs. Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,stun:stun.l.google.com:19302
TURN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_USERNAME=
TURN_CREDENTIAL=

# Security/rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=30
ROOM_TTL_MINUTES=120
MAX_ROOM_PLAYERS=2

# Optional: set REDIS_URL to enable Redis pub/sub for multi-instance horizontal scaling.
# Install ioredis first: npm install ioredis
# REDIS_URL=redis://localhost:6379
